# ── Telegram userbot (для ЧТЕНИЯ каналов) ──
# Получить на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# ── Telegram bot (интерфейс, куда ты кидаешь ссылки) ──
# Получить у @BotFather
TG_BOT_TOKEN=

# Кто может пользоваться ботом — твой Telegram user id (узнать у @userinfobot).
# Несколько — через запятую. Пусто = разрешено всем (не рекомендуется).
ALLOWED_USER_IDS=

# ── DeepSeek API ──
# Ключ с https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Модель. По умолчанию алиас на актуальную чат-модель DeepSeek.
# Для конкретно V4-Flash подставь её id из доков DeepSeek, когда понадобится.
DEEPSEEK_MODEL=deepseek-chat

# ── Хранилище и вывод ──
DB_PATH=data/knowledge.db
OUTPUT_DIR=output
USERBOT_SESSION=data/userbot
BOT_SESSION=data/bot

# Сколько последних постов/видео забирать при ПЕРВОМ разборе нового канала
INITIAL_FETCH_LIMIT=150
# Сколько постов слать модели за один запрос (для видео всегда по одному)
EXTRACT_BATCH_SIZE=10
# Максимум символов одного источника для модели (обрезка длинных расшифровок видео)
EXTRACT_MAX_CHARS=16000
